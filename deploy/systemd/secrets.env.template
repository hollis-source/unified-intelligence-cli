# Project Builder Secrets - systemd Environment File
# SECURITY: DO NOT COMMIT WITH REAL VALUES
#
# Usage:
#   1. Copy to /etc/project-builder/secrets.env
#   2. Replace REPLACE_WITH_* placeholders with real values
#   3. Set permissions: chmod 600 /etc/project-builder/secrets.env
#   4. Set ownership: chown ui-cli_jake:ui-cli_jake /etc/project-builder/secrets.env

# SurrealDB credentials
PB_DB_PASSWORD=REPLACE_WITH_SURREALDB_PASSWORD

# Redis credentials
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD

# LLM API keys
XAI_API_KEY=REPLACE_WITH_XAI_API_KEY
HUGGINGFACE_TOKEN=REPLACE_WITH_HUGGINGFACE_TOKEN
GITHUB_TOKEN=REPLACE_WITH_GITHUB_TOKEN
REPLICATE_API_TOKEN=REPLACE_WITH_REPLICATE_API_TOKEN

# Grafana credentials (if running locally)
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_GRAFANA_PASSWORD
