# Kubernetes Secrets Template for Project Builder
# SECURITY: DO NOT COMMIT WITH REAL VALUES
# Usage: Copy to secrets.yaml and populate with real values, then:
#   kubectl create secret generic project-builder-secrets \
#     --from-literal=surrealdb_root_password=<PASSWORD> \
#     --from-literal=redis_password=<PASSWORD> \
#     --from-literal=xai_api_key=<KEY> \
#     --from-literal=huggingface_token=<TOKEN> \
#     --from-literal=github_token=<TOKEN> \
#     --from-literal=replicate_api_token=<TOKEN> \
#     --from-literal=grafana_admin_password=<PASSWORD> \
#     --namespace project-builder

apiVersion: v1
kind: Secret
metadata:
  name: project-builder-secrets
  namespace: project-builder
  labels:
    app.kubernetes.io/name: project-builder
    app.kubernetes.io/component: configuration
type: Opaque
stringData:
  # SurrealDB credentials
  surrealdb_root_user: root
  surrealdb_root_password: REPLACE_WITH_REAL_PASSWORD

  # Redis credentials
  redis_password: REPLACE_WITH_REAL_PASSWORD

  # LLM API keys
  xai_api_key: REPLACE_WITH_REAL_KEY
  huggingface_token: REPLACE_WITH_REAL_TOKEN
  github_token: REPLACE_WITH_REAL_TOKEN
  replicate_api_token: REPLACE_WITH_REAL_TOKEN

  # Grafana credentials
  grafana_admin_password: REPLACE_WITH_REAL_PASSWORD
