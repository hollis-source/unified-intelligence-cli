```python
import pytest

def test_multiply_integers():
    assert multiply(2, 3) == 6.0
    assert multiply(-1, 5) == -5.0
    assert multiply(0, 100) == 0.0

def test_multiply_floats():
    assert multiply(2.5, 4.0) == 10.0
    assert multiply(0.0, 3.14) == 0.0
    assert multiply(-2.0, 3.5) == -7.0

def test_multiply_mixed_types():
    assert multiply(3, 2.5) == 7.5
    assert multiply(4.0, -2) == -8.0
    assert multiply(0, 0.0) == 0.0

def test_non_numeric_inputs():
    with pytest.raises(TypeError):
        multiply("2", 3)
    with pytest.raises(TypeError):
        multiply(2, "3")
    with pytest.raises(TypeError):
        multiply("a", "b")
