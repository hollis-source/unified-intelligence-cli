```python
import pytest

def test_multiply_integers():
    assert multiply(3, 4) == 12.0
    assert multiply(-2, 5) == -10.0
    assert multiply(0, 100) == 0.0

def test_multiply_floats():
    assert multiply(2.5, 3) == 7.5
    assert multiply(0.0, 5.6) == 0.0
    assert multiply(-1.5, -2.0) == 3.0

def test_multiply_mixed_types():
    assert multiply(3, 2.5) == 7.5
    assert multiply(-4.0, 5) == -20.0
    assert multiply(0, 0.0) == 0.0

def test_multiply_large_numbers():
    assert multiply(10**10, 10**10) == 1e+20  # Python handles big integers, but result is float

def test_multiply_type_errors():
    with pytest.raises(TypeError):
        multiply("3", 4)
    with pytest.raises(TypeError):
        multiply(3, "4")
    with pytest.raises(TypeError):
        multiply([1, 2], 3)
    with pytest.raises(TypeError):
        multiply(3, [4, 5])
