# Project Builder Production Environment Configuration
# Copy this file to .env.production and fill in actual values
# NEVER commit .env.production to version control!

# ============================================================================
# SurrealDB Configuration
# ============================================================================
SURREALDB_URL=http://surrealdb:8001
SURREALDB_NAMESPACE=project_builder
SURREALDB_DATABASE=production
SURREALDB_USERNAME=pb_app
SURREALDB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Database connection for Project Builder (legacy format)
PB_DB_TYPE=surrealdb
PB_DB_HOST=surrealdb
PB_DB_PORT=8000
PB_DB_NAMESPACE=project_builder
PB_DB_DATABASE=production
PB_DB_USER=root
PB_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ============================================================================
# Redis Configuration (LLM Cache)
# ============================================================================
REDIS_URL=redis://redis:6379/0
LLM_CACHE_ENABLED=true

# ============================================================================
# SSH / Remote FileStore Configuration
# ============================================================================
# Path to SSH private key inside container
PB_SSH_KEY_PATH=/home/pbuser/.ssh/id_ed25519
PB_SSH_KNOWN_HOSTS=/home/pbuser/.ssh/known_hosts

# SSH connection details (for health checks, optional)
# HEALTH_SSH_USER=deployer
# HEALTH_SSH_HOST=fileserver.prod.local

# ============================================================================
# LLM Provider API Keys
# ============================================================================
# OpenAI (GPT models)
OPENAI_API_KEY=sk-...

# X.AI (Grok models)
XAI_API_KEY=xai-...

# Hugging Face (for model downloads and inference)
HUGGINGFACE_TOKEN=hf_...

# ============================================================================
# Application Configuration
# ============================================================================
PB_ENV=production
PB_LOG_LEVEL=INFO
PB_LOG_FORMAT=json

# Health check timeout (milliseconds)
APP_HEALTH_TIMEOUT_MS=800

# Graceful shutdown timeout (seconds)
GRACEFUL_TIMEOUT_SECONDS=20

# Number of uvicorn workers (if using uvicorn)
UVICORN_WORKERS=2

# ============================================================================
# Observability / Monitoring
# ============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=8000

# OpenTelemetry (optional, for distributed tracing)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# OTEL_RESOURCE_ATTRIBUTES=service.name=project-builder

# ============================================================================
# LLM Execution Configuration
# ============================================================================
LLM_PROVIDER=hf
LLM_MODEL=Qwen/Qwen3-8B
LLM_TIMEOUT_MS=60000

# ============================================================================
# Python Configuration
# ============================================================================
PYTHONUNBUFFERED=1

# ============================================================================
# Grafana (for docker-compose monitoring stack)
# ============================================================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
