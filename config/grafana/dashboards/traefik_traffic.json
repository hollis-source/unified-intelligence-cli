{
  "uid": "traefik-traffic",
  "title": "Traefik Traffic",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "RPS (5m)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "options": {"reduceOptions": {"calcs": ["last"], "fields": "", "values": false}},
      "targets": [{"expr": "sum(rate(traefik_entrypoint_requests_total[5m]))", "legendFormat": "rps"}]
    },
    {
      "type": "timeseries",
      "title": "Requests by Status (5m)",
      "gridPos": {"x": 6, "y": 0, "w": 18, "h": 8},
      "options": {"legend": {"displayMode": "table"}},
      "targets": [{"expr": "sum by (code)(rate(traefik_entrypoint_requests_total[5m]))", "legendFormat": "{{code}}"}]
    },
    {
      "type": "timeseries",
      "title": "Latency P50/P95 (ms)",
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 8},
      "fieldConfig": {"defaults": {"unit": "ms"}},
      "targets": [
        {"expr": "1000 * histogram_quantile(0.50, sum by (le)(rate(traefik_entrypoint_request_duration_seconds_bucket[5m])))", "legendFormat": "p50"},
        {"expr": "1000 * histogram_quantile(0.95, sum by (le)(rate(traefik_entrypoint_request_duration_seconds_bucket[5m])))", "legendFormat": "p95"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Responses by Entrypoint (5m)",
      "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8},
      "targets": [{"expr": "sum by (entrypoint)(rate(traefik_entrypoint_responses_total[5m]))", "legendFormat": "{{entrypoint}}"}]
    }
  ]
}

