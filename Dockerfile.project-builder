# Production Dockerfile for Project Builder
# Multi-stage build with optimizations for deployment
# Sprint 1: Production Deployment - P1.1

# Stage 1: Builder - Install dependencies
FROM python:3.12-slim AS builder

WORKDIR /app

# Install build dependencies (minimal for faster builds)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install to user directory
COPY requirements.txt .
RUN pip install --user --no-cache-dir -r requirements.txt

# Stage 2: Runtime - Minimal production image
FROM python:3.12-slim

WORKDIR /app

# Install runtime dependencies (git for operations, curl for health checks)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    tini \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /root/.local /root/.local

# Copy application code
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY scripts/wait-for.sh ./wait-for.sh
COPY LICENSE ./

# Make wait-for script executable
RUN chmod +x ./wait-for.sh

# Create directories for Project Builder artifacts and database
RUN mkdir -p /app/projects /app/data /app/logs

# Set environment variables
ENV PATH=/root/.local/bin:$PATH \
    PYTHONPATH=/app:$PYTHONPATH \
    PYTHONUNBUFFERED=1

# Create non-root user for security
RUN useradd -m -u 1000 pbuser && \
    chown -R pbuser:pbuser /app

USER pbuser

# Expose health check port
EXPOSE 8000

# Health check via HTTP endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Use tini as init process (handles signals properly)
ENTRYPOINT ["/usr/bin/tini", "--"]

# Default: Show help (override with actual command)
CMD ["python", "-m", "src.project_builder.cli.command", "--help"]
