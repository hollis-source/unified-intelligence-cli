# ===== PHASE 1: PARALLEL EXECUTION (50 tasks broadcast) =====
# Use product operator to execute all 50 tasks concurrently
# Pattern: (t1 * t2 * ... * t50) o duplicate o input

functor phase1_code_quality = (refactor_adapters_quality * refactor_entities_quality * refactor_use_cases_quality * refactor_factories_quality * refactor_routing_quality * refactor_dsl_quality * refactor_interfaces_quality * refactor_validators_quality * refactor_utils_quality * refactor_priority_queue_quality) o duplicate o gather_codebase_context

functor phase1_architecture = (arch_check_adapters * arch_check_entities * arch_check_use_cases * arch_check_interfaces * arch_check_dsl * arch_check_factories * arch_check_routing * arch_check_circular_deps * arch_check_layer_violations * arch_check_solid_violations) o duplicate o gather_codebase_context

functor phase1_performance = (perf_optimize_dsl_parser * perf_optimize_htn_compiler * perf_optimize_executor_pool * perf_optimize_agent_factory * perf_optimize_llm_adapters * perf_optimize_database_queries * perf_optimize_metrics_collection * perf_optimize_memory_usage * perf_optimize_async_operations * perf_optimize_import_times) o duplicate o gather_codebase_context

functor phase1_testing = (test_adapters_coverage * test_entities_coverage * test_use_cases_coverage * test_dsl_coverage * test_factories_coverage * test_routing_coverage * test_integration_coverage * test_performance_benchmarks * test_error_handling * test_mutation_testing) o duplicate o gather_codebase_context

functor phase1_documentation = (doc_adapters * doc_entities * doc_use_cases * doc_dsl_guide * doc_api_reference * doc_architecture_adr * doc_deployment_guide * doc_troubleshooting * doc_migration_guides * doc_contributing_guide) o duplicate o gather_codebase_context

# ===== PHASE 2: AGGREGATE ALL 50 RESULTS =====

functor aggregate_all_refactoring_results = aggregate_refactoring_recommendations_from_all_50_parallel_analyses

functor synthesize_refactoring_plan = generate_comprehensive_refactoring_implementation_plan_with_prioritized_tasks

# ===== MAIN WORKFLOW =====
# All 5 phases execute in parallel (50 total tasks), then aggregate, then synthesize

functor all_parallel_analyses = (phase1_code_quality * phase1_architecture * phase1_performance * phase1_testing * phase1_documentation) o duplicate o input

functor main = synthesize_refactoring_plan o aggregate_all_refactoring_results o all_parallel_analyses
