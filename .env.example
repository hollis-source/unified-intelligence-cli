# Environment Variables for Production Deployment
# Sprint 1: Production Deployment Configuration
#
# IMPORTANT: Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control (already in .gitignore)

# ============================================================================
# LLM Provider API Keys
# ============================================================================
# xAI Grok API key (primary provider)
XAI_API_KEY=your_xai_api_key_here

# OpenAI API key (fallback/alternative provider)
OPENAI_API_KEY=your_openai_api_key_here

# Hugging Face token (for model access and inference)
HUGGINGFACE_TOKEN=your_huggingface_token_here

# ============================================================================
# Database Configuration (Production PostgreSQL)
# ============================================================================
# PostgreSQL password for production deployment
# SECURITY: Use a strong password in production!
PB_DB_PASSWORD=changeme_use_strong_password

# ============================================================================
# Grafana Configuration
# ============================================================================
# Grafana admin credentials
# SECURITY: Change these immediately after first login!
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme_use_strong_password

# ============================================================================
# Application Configuration
# ============================================================================
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
PB_LOG_LEVEL=INFO

# Environment (development, staging, production)
PB_ENV=production

# Optional: Override default provider
# UI_CLI_PROVIDER=grok

# Optional: Redis configuration (for PriorityWorker)
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_LOCK_TTL=3600